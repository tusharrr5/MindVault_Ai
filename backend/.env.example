# Node environment
NODE_ENV=development
PORT=8080

# Firebase Admin SDK (Use Application Default Credentials in production on Cloud Run)
# For local dev, you can use a service account key path
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Gemini API Integration
# Project ID and Location for Vertex AI (if using Vertex)
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=us-central1

# Or if using direct Gemini API key:
GEMINI_API_KEY=your_gemini_api_key_here
